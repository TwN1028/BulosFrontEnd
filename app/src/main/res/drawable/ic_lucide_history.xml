<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!--
        Lucide "History" — clock circle + CCW arrow + clock hands.
        Circle drawn as two semicircular arcs so Android handles it reliably.
    -->
    <!-- Clock circle: left half -->
    <path
        android:pathData="M12,3 C9.239,3 6.761,4.119 5,6"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"/>
    <!-- Clock circle: bottom + right + top-right, leaving gap at top-left for arrow -->
    <path
        android:pathData="M5,6 C3.119,7.761 2,9.757 2,12 C2,17.523 6.477,22 12,22 C17.523,22 22,17.523 22,12 C22,6.477 17.523,2 12,2 C10.399,2 8.889,2.391 7.562,3.079"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"/>
    <!-- CCW arrowhead: small L-shape at top-left of circle -->
    <path
        android:pathData="M3,3 L3,7 L7,7"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent"/>
    <!-- Clock hands: noon to centre, centre to 3 o'clock -->
    <path
        android:pathData="M12,7 L12,12 L15,15"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent"/>
</vector>
