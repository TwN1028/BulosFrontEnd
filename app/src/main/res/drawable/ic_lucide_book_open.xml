<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!--
        Lucide "BookOpen" icon — verified canonical paths
        Two open pages meeting at spine (x=12), no Z close so pages stay open
    -->
    <!-- Left page: top-left corner to spine bottom, then spine up to top -->
    <path
        android:pathData="M2,3 L2,20 C2,20 4.5,19 12,19 L12,3 C12,3 6,3 2,3"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent"/>
    <!-- Right page: mirror of left -->
    <path
        android:pathData="M22,3 L22,20 C22,20 19.5,19 12,19 L12,3 C12,3 18,3 22,3"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent"/>
</vector>
